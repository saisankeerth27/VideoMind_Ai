DATABASE_URL=postgresql://user:password@host:5432/dbname

AI_API_KEY=your_ai_api_key
AI_MODEL=gemini-flash-lite-latest
# For Google Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# For xAI/Grok: AI_BASE_URL=https://api.x.ai/v1

# Comma-separated list of allowed origins (your Vercel frontend URL + localhost for dev)
CORS_ORIGINS=http://localhost:5173

DEBUG=false